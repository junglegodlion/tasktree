{
  "name": "tasktree",
  "version": "1.1.0",
  "description": "任务拆解 · 计时 · 记录 一体化工具",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "build": "npm run icons && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "com.tasktree.app",
    "productName": "TaskTree",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
